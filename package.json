{
  "name": "prompt-crate",
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "type": "module",
  "description": "Local-first prompt snippet inserter for web input fields. No account, no cloud.",
  "scripts": {
    "dev": "node scripts/dev-watch.mjs",
    "dev:smoke": "node scripts/dev-watch.mjs --once",
    "build": "node scripts/build-extension.mjs",
    "build:content": "vite build --config vite.content.config.ts",
    "build:extension": "vite build",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test --grep-invert @real",
    "test:e2e:full": "pnpm build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "verify:dist": "node scripts/verify-dist.mjs",
    "package:zip": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.61.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
